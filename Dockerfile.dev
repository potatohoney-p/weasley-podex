# ─── Weasley Podex Docker image (local source) ────────────
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ chromium curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r weasley && useradd -r -g weasley -m weasley

WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts && npm rebuild better-sqlite3
COPY . .
RUN npm run build && npm run build:frontend

ENV WEASLEY_PODEX_HOME=/home/weasley/.weasley/podex
ENV PORT=3457
RUN node dist/bin/postinstall.js && chown -R weasley:weasley /home/weasley/.weasley
USER weasley
EXPOSE 3457

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD node -e "fetch('http://localhost:3457/api/health').then(r=>{if(!r.ok)throw 1})" || exit 1

ENTRYPOINT ["node", "--dns-result-order=ipv4first", "dist/server.js"]

