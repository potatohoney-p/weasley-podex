{
    "type":  "module",
    "name":  "jawcode",
    "version":  "0.1.0",
    "description":  "Jawcode (jwc) — structured coding-agent runtime CLI for podex and standalone use",
    "bin":  {
                "jwc":  "bin/jwc.js"
            },
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "import":  "./dist-node/sdk.js"
                          },
                    "./sdk":  {
                                  "types":  "./src/sdk.ts",
                                  "import":  "./dist-node/sdk.js"
                              }
                },
    "engines":  {
                    "bun":  "\u003e=1.3.14"
                },
    "files":  [
                  "bin",
                  "dist",
                  "dist-node",
                  "defaults/podex/settings.json",
                  "scripts/resolve-bun-runtime.cjs",
                  "scripts/verify-runtime.cjs",
                  "scripts/bootstrap-podex-home.cjs",
                  "src/index.ts",
                  "src/sdk.ts"
              ],
    "scripts":  {
                    "bundle":  "bun build src/cli-entry.ts --target=bun --outfile=dist/jwc.bundle.js --external mupdf --external markit-ai --external @gajae-code/natives \u0026\u0026 bun build ../stats/src/sync-worker.ts --target=bun --outfile=dist/sync-worker.js --external @gajae-code/natives",
                    "build:node":  "bun scripts/build-node.ts",
                    "postinstall":  "node scripts/verify-runtime.cjs --postinstall \u0026\u0026 node scripts/bootstrap-podex-home.cjs --postinstall",
                    "bootstrap:podex":  "node scripts/bootstrap-podex-home.cjs",
                    "verify:runtime":  "node scripts/verify-runtime.cjs",
                    "smoke:node-sdk":  "node scripts/smoke-node-sdk.mjs",
                    "smoke:packed-sdk":  "node scripts/smoke-packed-sdk.mjs"
                },
    "dependencies":  {
                         "@gajae-code/natives":  "0.4.4",
                         "markit-ai":  "0.5.3",
                         "better-sqlite3":  "^11.10.0",
                         "json5":  "^2.2.3",
                         "strip-ansi":  "^7.1.0",
                         "@silvia-odwyer/photon-node":  "0.3.4",
                         "bun":  "1.3.14"
                     },
    "devDependencies":  {
                            "@gajae-code/coding-agent":  "0.4.4",
                            "esbuild":  "^0.25.0",
                            "yaml":  "^2.6.0",
                            "smol-toml":  "^1.3.0",
                            "fflate":  "0.8.2"
                        }
}
