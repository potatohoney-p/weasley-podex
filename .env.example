# Weasley Podex Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 3457)
# PORT=3457

# Docker: WEASLEY_PODEX_HOME is auto-set in container. No manual config needed.
# Docker: Set CHROME_NO_SANDBOX=1 only if Chromium sandbox fails.

# Optional: replace the bundled skill catalog with a trusted Git repository.
# WEASLEY_PODEX_SKILLS_REPO=https://github.com/your-org/your-skills.git

# Optional: refresh the bundled MCP catalog from a trusted registry URL.
# WEASLEY_PODEX_MCP_REGISTRY_URL=https://example.com/mcp-registry.json

# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=
# Discord guild (server) ID
DISCORD_GUILD_ID=
# Comma-separated Discord channel IDs the bot can use
DISCORD_CHANNEL_IDS=
